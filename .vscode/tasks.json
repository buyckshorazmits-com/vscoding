{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cppbuild",
			"label": "C/C++: g++.exe 生成活动文件",
			"command": "D:\\mingw64\\bin\\g++.exe",
			"args": [
				"-Wall",
				"-Wextra",
				"-Wpedantic",
				"-Wshadow",
				"-Wformat=2",
				"-Wcast-align",
				"-Wconversion",
				"-Wsign-conversion",
				"-Wnull-dereference",
				"-g3",
				"-O0",
				"-include",
				"${workspaceFolder}/C++/common.h",
				"${file}",
				"-o",
				"${workspaceFolder}/build/Debug/outDebug.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "编译当前活动 C++ 源文件"
		},
		{
			"type": "shell",
			"label": "C/C++: 编译并运行当前文件",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"& 'D:/mingw64/bin/g++.exe' -Wall -Wextra -Wpedantic -Wshadow -Wformat=2 -Wcast-align -Wconversion -Wsign-conversion -Wnull-dereference -g3 -O0 -include \"${workspaceFolder}/C++/common.h\" \"${file}\" -o \"${workspaceFolder}/build/Debug/outDebug.exe\"; if ($LASTEXITCODE -eq 0) { & \"${workspaceFolder}/build/Debug/outDebug.exe\" }"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"detail": "编译并运行当前活动 C++ 源文件（默认任务）"
		},
		{
			"type": "shell",
			"label": "C/C++: 编译职工管理系统(多文件)",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}/build_worker.ps1"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": "build",
			"detail": "增量编译职工管理系统（只重编修改过的文件，快速）"
		},
		{
			"type": "shell",
			"label": "C/C++: 编译并运行职工管理系统",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-Command",
				"& \"${workspaceFolder}/build_worker.ps1\"; .\\build\\Debug\\outDebug.exe"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": "build",
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			},
			"detail": "增量编译职工管理系统并运行（一条龙）"
		},
		{
			"type": "shell",
			"label": "C/C++: 运行程序",
			"command": ".\\build\\Debug\\outDebug.exe",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"dependsOn": [
				"C/C++: 编译职工管理系统(多文件)"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"focus": true
			}
		}
	]
}